# Django Settings
DJANGO_SECRET_KEY=brofessor-insecure-dev-secret-key-change-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# Local Storage Mapping
# Unified data directory (mapped to host PC storage in Docker container via -v ./data:/data)
DATA_DIR=./data

# Database Settings
# Set DB_ENGINE=sqlite for local standalone zero-config execution (default)
# Set DB_ENGINE=postgresql for PostgreSQL + pgvector
DB_ENGINE=sqlite
DB_NAME=brofessor_db
DB_USER=brofessor_user
DB_PASSWORD=brofessor_password
DB_HOST=127.0.0.1
DB_PORT=5432

# Redis & Celery (optional; defaults to in-memory cache and eager processing in standalone mode)
# REDIS_URL=redis://127.0.0.1:6379/0
# CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# Ollama / LLM Settings (Local-first)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Embedding Settings
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384
EMBEDDING_BATCH_SIZE=32

# RAG & Retrieval Pipeline
RAG_RETRIEVAL_TOP_K=10
RAG_RERANK_TOP_K=4
RAG_MAX_CONTEXT_CHARS=4000
RAG_TEMPERATURE=0.2

# Logging
LOG_LEVEL=INFO
